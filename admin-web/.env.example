# Supabase Configuration (Client & Server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Console Credentials (Server-side only - never prefixed with VITE_)
ADMIN_EMAIL=tseki.cecsystem@gmail.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SYSTEM_EMAIL=tseki.cecsystem@gmail.com
ADMIN_OTP_SECRET=replace_with_a_random_32_char_secret

# Gmail SMTP Configuration for Sending Admin OTP Emails
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=tseki.cecsystem@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
